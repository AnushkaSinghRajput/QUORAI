# QUORAI production research stack
# Copy to `.env.local` and replace placeholders with real secrets.
# Never commit `.env.local`. Never present mock answers as live research.

# --- Primary providers (required for live research) ---
SEARCH_PROVIDER=tavily
LLM_PROVIDER=openai

TAVILY_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Optional fallbacks ---
# SERPER_API_KEY=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Set to 1 only when you intentionally want labeled demo answers.
# ALLOW_MOCK_FALLBACK=0

# --- Auth ---
AUTH_SECRET=

# --- Optional product API ---
# QUORAI_API_KEY=
# CORS_ORIGIN=http://localhost:3000
# CONTACT_WEBHOOK_URL=

# --- Ops ---
# LOG_LEVEL=info
# RESEARCH_RATE_LIMIT=30
# RESEARCH_RATE_WINDOW_MS=60000

# --- Failproof AI (server only; official /v1 ingest) ---
# Mint in the quoraai workspace: Administration → Keys
# FAILPROOFAI_API_KEY needs events:add (ship).
# For Cloud verify either add events:read on that key (dashboard; human session)
# or set FAILPROOFAI_READ_API_KEY to a separate read-capable key.
# Do NOT set FAILPROOFAI_ORG for organization-scoped keys.
FAILPROOFAI_API_KEY=
# FAILPROOFAI_READ_API_KEY=
# FAILPROOFAI_ORG=
FAILPROOFAI_API_BASE=https://app.befailproof.ai/v1
FAILPROOFAI_ENVIRONMENT=development
FAILPROOFAI_AGENT_ID=quorai-research
FAILPROOFAI_CAPTURE_CONTENT=1
# FAILPROOFAI_ENFORCE_DRIFT=
# FAILPROOFAI_ENFORCE_EVIDENCE=

# --- Vercel Production (set in dashboard or `vercel env add`) ---
# AUTH_SECRET
# TAVILY_API_KEY
# OPENAI_API_KEY
# OPENAI_MODEL
# FAILPROOFAI_API_KEY
# FAILPROOFAI_READ_API_KEY (optional)
# FAILPROOFAI_ENVIRONMENT=production
# SEARCH_PROVIDER=tavily
# LLM_PROVIDER=openai
# ALLOW_MOCK_FALLBACK=0
