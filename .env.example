# QUORAI environment configuration
# Copy to `.env.local` and fill in the keys you want to use.
# With no keys set, QUORAI runs fully in demo mode (mock search + mock LLM).

# --- Provider selection ---
# auto | mock | tavily | serper
SEARCH_PROVIDER=auto

# auto | mock | openai | anthropic
LLM_PROVIDER=auto

# --- Search providers (pick one) ---
TAVILY_API_KEY=
SERPER_API_KEY=

# --- LLM providers (pick one) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Auth ---
AUTH_SECRET=change-me-in-production

# --- Optional product API ---
# QUORAI_API_KEY=
# CORS_ORIGIN=http://localhost:3000
# CONTACT_WEBHOOK_URL=

# --- Optional ops ---
# LOG_LEVEL=info
# RESEARCH_RATE_LIMIT=30
# RESEARCH_RATE_WINDOW_MS=60000

# --- Failproof AI (server only; never expose these to the browser) ---
# Organization-scoped key from the quoraai workspace: Administration → Keys.
# events:add ships traces. events:read powers Verify. The workspace URL is not an API.
# FAILPROOFAI_API_KEY=
# Instance-scoped keys only:
# FAILPROOFAI_ORG=quoraai
# Override the documented Cloud /v1 base. Do not put the workspace path here.
# FAILPROOFAI_API_BASE=https://app.befailproof.ai/v1
# development | production, or omit to follow NODE_ENV. No commas.
# FAILPROOFAI_ENVIRONMENT=
# FAILPROOFAI_AGENT_ID=quorai-research
# Set to 0 to keep prompts and answers out of the trace.
# FAILPROOFAI_CAPTURE_CONTENT=1
# Set to 1 to block a run when drift or evidence checks fail.
# FAILPROOFAI_ENFORCE_DRIFT=
# FAILPROOFAI_ENFORCE_EVIDENCE=
