{
  "name": "quorai",
  "version": "1.0.0",
  "private": true,
  "description": "QUORAI — AI-powered web research",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
